# ------------------------------------------------------------------------------
# National College - environment variables
# Copy this file to `.env` and fill in the values for your environment.
# ------------------------------------------------------------------------------

# ---- Database (Postgres) -----------------------------------------------------
# Connection string for the Postgres database. This is the only database
# variable that's strictly required. Formats:
#   postgresql://user:password@host:5432/dbname?schema=public
#   postgres://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/national_college

# Optional: older/alternate names that the code falls back to if DATABASE_URL
# is not set. Useful when deploying to hosts that inject their own var name.
# SUPABASE_DB_URL=
# POSTGRES_URL=

# Force SSL on the database connection. Set to "true" if your host requires it.
PGSSL=false

# ---- Auth / JWT ---------------------------------------------------------------
# Two independent secrets (each >= 32 chars, random). Generate with:
#   openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
AUTH_REFRESH_SECRET=replace-with-a-different-long-random-string

# Public site URL (no trailing slash). Used for OAuth redirect URIs and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable email OTP flows end-to-end. When "true", newly registered users must
# verify their email before they can log in. Requires SMTP settings below.
AUTH_OTP_ENABLED=false

# Secret required to bootstrap the first CMS admin via PUT /api/cms/auth.
# Generate with `openssl rand -hex 32` and keep it private.
CMS_SETUP_SECRET=

# ---- OAuth 2.0 providers (optional) -----------------------------------------
# Uncomment and configure the provider(s) you want to enable. The public site
# URL + the callback path is added to the redirect URI auto-magically:
#   {NEXT_PUBLIC_SITE_URL}/api/auth/callback/google
#   {NEXT_PUBLIC_SITE_URL}/api/auth/callback/github

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials):
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth (GitHub -> Settings -> Developer settings -> OAuth Apps):
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ---- SMTP / transactional email (optional) ----------------------------------
# Any REST-based transactional email provider works (Resend, SendGrid, Postmark,
# etc.) as long as it accepts { from, to[], subject, text } JSON and Bearer auth.
# When not configured, OTP codes are printed to the server console (dev only).
# AUTH_SMTP_API_URL=https://api.resend.com/emails
# AUTH_SMTP_API_KEY=
# AUTH_SMTP_FROM=National College <no-reply@yourdomain.edu.in>
