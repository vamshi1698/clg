# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Examples for Vercel / Cloud Deployments:
# - Neon / Neon Serverless (Recommended for Vercel free tier):
#   DATABASE_URL=postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# - Supabase (Transaction Pooler - port 6543):
#   DATABASE_URL=postgresql://postgres.projectref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# - Local Development:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/national_college
DATABASE_URL=postgresql://username:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/databasename?sslmode=require

# ==============================================================================
# SECURITY & AUTHENTICATION SECRETS (Required in Production)
# ==============================================================================
# Generate secure 32+ character random strings (e.g. `openssl rand -hex 32`)
CMS_SESSION_SECRET=your-secure-random-cms-session-secret-min-32-chars
CMS_SETUP_SECRET=your-secure-random-cms-setup-secret-min-32-chars

# Maximum login attempts within the rate limit window
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# ==============================================================================
# FILE STORAGE CONFIGURATION (Supabase Storage / Cloud / Local)
# ==============================================================================
# Supabase Cloud Storage (Recommended for Vercel / Cloud deployments):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx

# For VPS/Docker/Self-hosted local disk storage (Optional):
# UPLOAD_DIR=/var/data/uploads
# RESULTS_UPLOAD_DIR=/var/data/results

# ==============================================================================
# EMAIL NOTIFICATIONS (Resend - Optional)
# ==============================================================================
# If omitted, contact form submissions and alerts will log to server console
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Administrator contact details for notifications
ADMIN_ALERT_EMAIL=admissions@nationalcollege.edu
ADMIN_PHONE_NUMBER=+919999999999

# Application base URL
APP_URL=https://your-domain.vercel.app

